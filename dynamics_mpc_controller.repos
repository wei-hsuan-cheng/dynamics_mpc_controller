repositories:
    # mujoco simulator
    dynamics_mpc_controller_dependencies/mujoco_ros2_control:
      type: git
      url: https://github.com/wei-hsuan-cheng/mujoco_ros2_control.git
      version: jazzy

    # ocs2 stack
    dynamics_mpc_controller_dependencies/ocs2_ros2:
      type: git
      url: https://github.com/wei-hsuan-cheng/ocs2_ros2.git
      version: jazzy
    dynamics_mpc_controller_dependencies/ocs2_ros2/submodules/ocs2_robotic_assets:
      type: git
      url: https://github.com/wei-hsuan-cheng/ocs2_robotic_assets.git
      version: ros2_x86
    dynamics_mpc_controller_dependencies/ocs2_ros2/submodules/plane_segmentation_ros2:
      type: git
      url: https://github.com/wei-hsuan-cheng/plane_segmentation_ros2.git
      version: main